# Aarogya Environment Configuration (Phase 2)
# ===================================================

# Execution Mode:
#   SIMULATION            - Safe local testing using fictional data and mock connectors (default)
#   CONNECTED_READ_ONLY   - Read-only operations against configured external services
#   AUTHORIZED_EXECUTION  - Full operations with explicit human approval gates
AAROGYA_EXECUTION_MODE=SIMULATION

# AgenticOrg Platform Configuration (Phase 3 Module 7)
# Note: In SIMULATION mode, these may be empty or use mock credentials
AGENTICORG_ENABLED=false
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://app.agenticorg.ai
AGENTICORG_GRANTEX_TOKEN=
AGENTICORG_AGENT_ID=aarogya
AGENTICORG_CONFIDENCE_FLOOR=0.88
AGENTICORG_DEPLOYMENT_STATUS=shadow
AGENTICORG_DISCOVERY_TIMEOUT_SECONDS=10.0

# Direct Pharmacy Integration Configuration
# Selected architecture: Direct pharmacy API integration (not ONDC)
PHARMACY_API_BASE_URL=
PHARMACY_API_KEY=
PHARMACY_TIMEOUT_SECONDS=5.0
PHARMACY_CONNECTOR_ENABLED=false

# Caregiver Task Backend Configuration
TASK_MANAGER_API_BASE_URL=
TASK_MANAGER_API_KEY=
TASK_MANAGER_CONNECTOR_ENABLED=false

# Pine Labs Payment Integration (Consequential - requires separate explicit approval)
PINE_LABS_MERCHANT_ID=
PINE_LABS_API_KEY=
PAYMENTS_ENABLED=false

# Delhivery Logistics Integration (Outcome verification required)
DELHIVERY_API_KEY=
LOGISTICS_ENABLED=false

# Logging & Audit
LOG_LEVEL=INFO
AUDIT_LOG_FILE=aarogya_audit.log
REDACT_SENSITIVE_DATA=true
